# Public site URL — used for canonical/hreflang tags, the sitemap, and to
# validate the submission endpoint's Origin/Referer header.
NEXT_PUBLIC_SITE_URL=https://cuantoctg.vercel.app

# Supabase project (Settings -> API). The URL isn't sensitive. The service
# role key is — never the anon key, and never referenced from client code.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing submitter IPs (HMAC-SHA256). Generate your own locally,
# e.g. `openssl rand -hex 32` — never share or commit the real value.
IP_HASH_SALT=
